rules_version = '2';
service cloud_firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(userId, incoming()) && isLinkedVoucherValid(incoming().voucher);
      allow update, delete: if false;
    }

    match /promo_vouchers/{voucherCode} {
      allow get: if isSignedIn() && (existing().used == false || existing().usedBy == request.auth.token.email);
      allow list: if false; // Block query harvesting
      allow create: if isSignedIn() && isValidNewVoucher(incoming()); // Permit any signed-in user to seed vouchers for testing
      allow update: if isSignedIn() && isValidRedemption(voucherCode, incoming(), existing());
      allow delete: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(userId, data) {
      return data.keys().hasAll(['uid', 'email', 'voucher', 'createdAt'])
        && data.keys().size() == 4
        && data.uid == userId
        && data.email == request.auth.token.email
        && data.voucher is string
        && data.voucher.size() <= 50
        && data.createdAt == request.time;
    }

    // Validates that the voucher code actually exists and was atomically set to used in standard same-batch write
    function isLinkedVoucherValid(voucherCode) {
      return getAfter(/databases/$(database)/documents/promo_vouchers/$(voucherCode)).data.used == true
        && getAfter(/databases/$(database)/documents/promo_vouchers/$(voucherCode)).data.usedBy == request.auth.token.email;
    }

    // Validates new voucher shape during seeding
    function isValidNewVoucher(data) {
      return data.keys().hasAll(['code', 'duration', 'used', 'usedBy', 'usedAt'])
        && data.keys().size() == 5
        && data.code is string
        && data.code.size() <= 50
        && data.duration is string
        && data.used == false
        && data.usedBy == ""
        && data.usedAt == null;
    }

    // Validates that the voucher is transitioning from used = false to used = true, assigned to the authenticated user,
    // and that the matching user document is atomically created in the same transaction.
    function isValidRedemption(voucherCode, data, current) {
      return current.used == false
        && data.used == true
        && data.usedBy == request.auth.token.email
        && data.usedAt == request.time
        && data.code == current.code
        && data.duration == current.duration
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.voucher == voucherCode;
    }
  }
}
